# Copia este archivo como .env y completa los valores
DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/condominio
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
# Opcional: número de WhatsApp de la administración.
# Si se deja vacío, se usa el teléfono del usuario Administrador.
WHATSAPP_NUMERO=
# Código de país que se agrega a los números de 8 dígitos (Guatemala = 502)
CODIGO_PAIS=502
# Solo para el primer arranque en línea (Render): crea el administrador si aún no existe.
# Mínimo 8 caracteres. Si ya corriste seed.py contra la base, no hace falta.
ADMIN_EMAIL=admin@condominio.com
ADMIN_PASSWORD=
